class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        // ll me ek hi element ho 
        if ( head.next== null ) {
        return null;
        
    }

    // For Size of the LL 
    int size = 0;
    ListNode curr = head;
    while ( curr != null ) {
        curr = curr.next;
        size++;
    }
    if ( n== size){
    return head.next;
    }
    int indexToSearch = size-n; // previous nide size -n pe lise karegi 
    ListNode prev  = head;
    int i = 1 ;
    while( i < indexToSearch) {
        prev = prev.next;
        i++;
    }
    prev.next = prev.next.next;
    return head;
}
}